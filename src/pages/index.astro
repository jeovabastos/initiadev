---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_PROJECTS_ON_HOMEPAGE);

const study = (await getCollection("study"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);

---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white">
      Olá, meu nome é Jeová Bastos <span class="text-xl">🦖</span> 
    </h4>

    <div class="space-y-16">
      <!-- HEADER -->
      <section>
        <article class="space-y-4">
          <!-- what is my focus -->
          <p class="animate">
            Sou um desenvolvedor focado no mercado criativo, tanto em ferramentas online quanto offline, desde ferramentas de arte até produtos finais, como fóruns comunitários e jogos. Você pode encontrar meus projetos em meu perfil do 
            <Link href="https://github.com/jeovabastos" aria-label="jeovabastos on Github" external>
              Github
            </Link>.
          </p>

          <!-- how do I approach my goal -->
          <p class="animate">
            Meu foco principal é desenvolver ferramentas de arte de código aberto para criação colaborativa, como o meu gerenciador de assets digitais offline <Link href="https://propositum-formarum.vercel.app" aria-label="propositum formarum landing page" external>Propositum Formarum</Link>. 
          </p>

          <!-- future intentions -->
          <p class="animate">
            No futuro, quero criar um conjunto de ferramentas que componha um ecossistema artístico de código aberto e multiplataforma, começando com suporte prioritário para Linux. 
          </p>
        </article>
      </section>

      <!-- POSTS -->
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Posts
          </h5>
          <Link href="/blog">
            Ver todos os posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>
      
      <!-- PROJECTS -->
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Projetos
          </h5>
          <Link href="/projects">
            Ver todos os projetos
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {projects.map(project => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>
      
      <!-- STUDY -->
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Escolaridade
          </h5>
          <Link href="/study">
            Ver todo o registro de estudos
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {study.map(entry => (
            <li>
              <div class="text-sm opacity-75">
                {dateRange(entry.data.dateStart, entry.data.dateEnd)}
              </div>
              <div class="font-semibold text-black dark:text-white">
                {entry.data.instituition}
              </div>
              <div class="text-sm opacity-75">
                {entry.data.course}
              </div>
            </li>
          ))}
        </ul>
      </section>


      <!-- CONTACT -->
      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          Contatos
        </h5>
        <article>
          <p>
            Se você quiser entrar em contato comigo sobre algo ou apenas para dizer oi,
            fale comigo pelas redes sociais ou envie um e-mail.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
